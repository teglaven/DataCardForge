# ── Dependencies / build output ────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
build/
*.local

# ── Test / verification artifacts (regenerated by web/scripts/smoke.mjs) ───
smoke-report.txt
smoke-screenshot.png
.smoke-downloads/
coverage/

# ── Pre-migration safety backup: full history of the old Qt repo ───────────
.pre-qt-removal-backup/

# ── Playwright browser binaries (installed into the repo when $HOME is not
