# ── Dependencies / build output ────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local

# ── Test / verification artifacts (regenerated by web/scripts/smoke.mjs) ───
smoke-report.txt
smoke-screenshot.png
.smoke-downloads/
coverage/

# ── Pre-migration safety backup: full history of the old Qt repo ───────────
.pre-qt-removal-backup/

# ── Playwright browser binaries (installed into the repo when $HOME is not
#    writable; ~120 MB, never committed) ────────────────────────────────────
.cache/

# ── Editor / OS ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# ── Private notes (Obsidian vault, never published) ────────────────────────
docs/docs/private/

# ── Obsidian local state ────────────────────────────────────────────────────
docs/docs/.obsidian/workspace*

# ── Local end-to-end test runtime (rootless Chromium + its .so deps) ───────
# Reproducible machine-local scaffolding for scripts/smoke.mjs, never published.
.local-libs/
.pw-browsers/
.npm-cache/

# ── Local Playwright probes used for UI auditing (never published) ──────────
web/.probe/

# ── Local agent/audit scratch space (probe scripts, stress logs, build trials)
# Never published: reproducible assets get promoted into backend/tests/ or
# scripts/ before they count as a regression defence (see docs/docs/history.md
# §6.1-2 "可复跑 ≠ 在别人机器上能复跑").
work/

# ── 本机 agent 协议：不入库 ────────────────────────────────────────────────
# AGENTS.md 含本机绝对路径、systemd 单元名与端口，属工作区协议而非项目产物。
AGENTS.md

# ── 临时探针：调试用，用完即删（真防线是 backend/tests/ 与 web/tests/ 的正式用例）──
# 保留忽略规则，防止将来的临时探针被误提交。
web/src/probe.ts
web/tests/*.probe.test.ts

# ── 本地工具环境（venv 等）────────────────────────────────────────────────
.tools/
