{
  "comment": "Cross-tier differential fixtures — the single judge format (docs/architecture/backend-protocol-v1.md). The TS reference implementation and the C++ engine must both run this file. Non-finite values are encoded as the strings \"NaN\" / \"Infinity\" / \"-Infinity\" because JSON cannot carry them.",
  "cases": [
    { "name": "add", "columns": [{ "name": "A", "data": [1, 2, 3] }, { "name": "B", "data": [4, 5, 6] }], "expression": "A + B", "expect": [5, 7, 9], "tol": 0 },
    { "name": "precedence", "columns": [{ "name": "A", "data": [1] }, { "name": "B", "data": [2] }, { "name": "C", "data": [3] }], "expression": "A + B * C", "expect": [7], "tol": 0 },
    { "name": "parentheses", "columns": [{ "name": "A", "data": [1] }, { "name": "B", "data": [2] }, { "name": "C", "data": [3] }], "expression": "(A + B) * C", "expect": [9], "tol": 0 },
    { "name": "unary-minus", "columns": [{ "name": "A", "data": [3] }, { "name": "B", "data": [10] }], "expression": "-A + B", "expect": [7], "tol": 0 },
    { "name": "power-right-assoc", "columns": [], "expression": "2 ^ 3 ^ 2", "expect": [512], "tol": 0 },
    { "name": "modulo", "columns": [{ "name": "A", "data": [7, 8, 9] }], "expression": "A % 3", "expect": [1, 2, 0], "tol": 0 },
    { "name": "div-zero-inf", "columns": [{ "name": "A", "data": [1] }, { "name": "B", "data": [0] }], "expression": "A / B", "expect": ["Infinity"], "tol": 0 },
    { "name": "nan-propagates", "columns": [{ "name": "A", "data": ["NaN", 2] }, { "name": "B", "data": [1, 1] }], "expression": "A + B", "expect": ["NaN", 3], "tol": 0 },
    { "name": "sign-nan-propagates", "columns": [{ "name": "A", "data": ["NaN", -3, 0, 2.5] }], "expression": "SIGN(A)", "expect": ["NaN", -1, 0, 1], "tol": 0 },
    { "name": "min-nan-propagates", "columns": [{ "name": "A", "data": [1, "NaN"] }], "expression": "MIN(A, 0)", "expect": [0, "NaN"], "tol": 0 },
    { "name": "max-nan-propagates", "columns": [{ "name": "A", "data": [1, "NaN"] }], "expression": "MAX(A, 0)", "expect": [1, "NaN"], "tol": 0 },
    { "name": "round-half-toward-positive-infinity", "columns": [{ "name": "A", "data": [-1.5, -2.5, 0.5, 2.5] }], "expression": "ROUND(A)", "expect": [-1, -2, 1, 3], "tol": 0 },
    { "name": "pow-one-with-nan-exponent", "columns": [{ "name": "A", "data": [0] }, { "name": "B", "data": [0] }], "expression": "POW(1, A / B)", "expect": ["NaN"], "tol": 0 },
    { "name": "pow-neg-one-with-inf-exponent", "columns": [{ "name": "A", "data": [0] }], "expression": "POW(-1, 1 / A)", "expect": ["NaN"], "tol": 0 },
    { "name": "pow-operator-follows-js-spec", "columns": [{ "name": "A", "data": [0] }, { "name": "B", "data": [0] }], "expression": "1 ^ (A / B)", "expect": ["NaN"], "tol": 0 },
    { "name": "mov-infinite-window-averages-whole-series", "columns": [{ "name": "A", "data": [1, 2, 3] }, { "name": "B", "data": [0, 0, 0] }], "expression": "MOV(A, 1 / B)", "expect": [2, 2, 2], "tol": 0 },
    { "name": "compare-gt", "columns": [{ "name": "A", "data": [5, 3, 1] }, { "name": "B", "data": [2, 3, 4] }], "expression": "A > B", "expect": [1, 0, 0], "tol": 0 },
    { "name": "compare-eq-ne", "columns": [{ "name": "A", "data": [1, 2, 3] }], "expression": "A == 2", "expect": [0, 1, 0], "tol": 0 },
    { "name": "sum-broadcasts", "columns": [{ "name": "A", "data": [1, 2, 3, 4] }], "expression": "SUM(A)", "expect": [10, 10, 10, 10], "tol": 0 },
    { "name": "avg-mean", "columns": [{ "name": "A", "data": [2, 4, 6] }], "expression": "AVG(A)", "expect": [4, 4, 4], "tol": 0 },
    { "name": "min-max-scalar", "columns": [{ "name": "A", "data": [3, 1, 2] }], "expression": "MIN(A)", "expect": [1, 1, 1], "tol": 0 },
    { "name": "min-elementwise", "columns": [{ "name": "A", "data": [1, 5, 3] }, { "name": "B", "data": [4, 2, 6] }], "expression": "MIN(A, B)", "expect": [1, 2, 3], "tol": 0 },
    { "name": "median-odd", "columns": [{ "name": "A", "data": [1, 3, 2] }], "expression": "MEDIAN(A)", "expect": [2, 2, 2], "tol": 0 },
