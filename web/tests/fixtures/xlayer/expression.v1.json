    { "name": "if-literal", "columns": [{ "name": "A", "data": [-1, 2, -3, 4] }], "expression": "IF(A > 0, A, 0)", "expect": [0, 2, 0, 4], "tol": 0 },
    { "name": "if-columns", "columns": [{ "name": "A", "data": [1, 5] }, { "name": "B", "data": [3, 2] }], "expression": "IF(A > B, A, B)", "expect": [3, 5], "tol": 0 },
    { "name": "pos-names", "columns": [{ "name": "Pos.1", "data": [1] }, { "name": "Pos.2", "data": [2] }], "expression": "Pos.1 + Pos.2", "expect": [3], "tol": 0 },
    { "name": "case-insensitive-ref", "columns": [{ "name": "A", "data": [1] }, { "name": "B", "data": [2] }], "expression": "a + b", "expect": [3], "tol": 0 },
    { "name": "zscore-combined", "columns": [{ "name": "A", "data": [1, 2, 3, 4] }], "expression": "(A - AVG(A)) / STD(A)", "expect": [-1.1618950038622251, -0.3872983346207417, 0.3872983346207417, 1.1618950038622251], "tol": 1e-9 },
    { "name": "count-skips-nan-and-inf", "columns": [{ "name": "A", "data": [1, "NaN", 3, "Infinity"] }], "expression": "COUNT(A)", "expect": [2, 2, 2, 2], "tol": 0 },
    { "name": "count-empty-column", "columns": [{ "name": "A", "data": [] }], "expression": "COUNT(A)", "expect": [0], "tol": 0 },
    { "name": "nan-counts-only-nan", "columns": [{ "name": "A", "data": [1, "NaN", "Infinity", "NaN"] }], "expression": "NAN(A)", "expect": [2, 2, 2, 2], "tol": 0 },
    { "name": "nan-empty-column", "columns": [{ "name": "A", "data": [] }], "expression": "NAN(A)", "expect": [0], "tol": 0 },
    { "name": "var-sample", "columns": [{ "name": "A", "data": [1, 2, 3, 4] }], "expression": "VAR(A)", "expect": [1.6666666666666667, 1.6666666666666667, 1.6666666666666667, 1.6666666666666667], "tol": 0 },
    { "name": "var-single-value", "columns": [{ "name": "A", "data": [5] }], "expression": "VAR(A)", "expect": [0], "tol": 0 },
    { "name": "var-empty-column", "columns": [{ "name": "A", "data": [] }], "expression": "VAR(A)", "expect": ["NaN"], "tol": 0 },
