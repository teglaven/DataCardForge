    { "name": "agg-skips-nan", "columns": [{ "name": "A", "data": [1, "NaN", 3] }], "expression": "SUM(A)", "expect": [4, 4, 4], "tol": 0 },
    { "name": "abs", "columns": [{ "name": "A", "data": [-3, 0, 5] }], "expression": "ABS(A)", "expect": [3, 0, 5], "tol": 0 },
    { "name": "sqrt", "columns": [{ "name": "A", "data": [4, 9, 16] }], "expression": "SQRT(A)", "expect": [2, 3, 4], "tol": 0 },
    { "name": "ln", "columns": [{ "name": "A", "data": [2.718281828459045] }], "expression": "LN(A)", "expect": [1], "tol": 1e-12 },
    { "name": "log10", "columns": [{ "name": "A", "data": [100] }], "expression": "LOG10(A)", "expect": [2], "tol": 1e-12 },
    { "name": "round-decimals", "columns": [{ "name": "A", "data": [3.14159] }], "expression": "ROUND(A, 1)", "expect": [3.1], "tol": 1e-12 },
    { "name": "round-default", "columns": [{ "name": "A", "data": [3.7] }], "expression": "ROUND(A)", "expect": [4], "tol": 0 },
    { "name": "exp-pow-sign-floor-ceil", "columns": [{ "name": "A", "data": [1.2, -0.7] }], "expression": "POW(CEIL(A), 2) + FLOOR(-A) + SIGN(A) * 0 + EXP(LN(2))", "expect": [4, 2], "tol": 1e-12 },
    { "name": "mov-window", "columns": [{ "name": "A", "data": [1, 2, 3, 4, 5] }], "expression": "MOV(A, 3)", "expect": [1.5, 2, 3, 4, 4.5], "tol": 1e-12 },
