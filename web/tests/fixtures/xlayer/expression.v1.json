    { "name": "quantile-median-even", "columns": [{ "name": "A", "data": [1, 2, 3, 4] }], "expression": "QUANTILE(A, 0.5)", "expect": [2.5, 2.5, 2.5, 2.5], "tol": 0 },
    { "name": "quantile-q3-even", "columns": [{ "name": "A", "data": [1, 2, 3, 4] }], "expression": "QUANTILE(A, 0.75)", "expect": [3.25, 3.25, 3.25, 3.25], "tol": 0 },
    { "name": "quantile-endpoint-zero", "columns": [{ "name": "A", "data": [3, 1, 2] }], "expression": "QUANTILE(A, 0)", "expect": [1, 1, 1], "tol": 0 },
    { "name": "quantile-endpoint-one", "columns": [{ "name": "A", "data": [3, 1, 2] }], "expression": "QUANTILE(A, 1)", "expect": [3, 3, 3], "tol": 0 },
