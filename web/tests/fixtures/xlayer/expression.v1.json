    { "name": "sem-single-value", "columns": [{ "name": "A", "data": [5] }], "expression": "SEM(A)", "expect": [0], "tol": 0 },
    { "name": "sem-empty-column", "columns": [{ "name": "A", "data": [] }], "expression": "SEM(A)", "expect": [0], "tol": 0 },
    { "name": "sem-over-std-is-one-over-sqrt-n", "columns": [{ "name": "A", "data": [1, 2, 3, 4] }], "expression": "SEM(A) / STD(A)", "expect": [0.5, 0.5, 0.5, 0.5], "tol": 0 },
