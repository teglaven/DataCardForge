    { "name": "quantile-clamps-above-one", "columns": [{ "name": "A", "data": [3, 1, 2] }], "expression": "QUANTILE(A, 2)", "expect": [3, 3, 3], "tol": 0 },
    { "name": "quantile-per-row-q-from-column", "columns": [{ "name": "A", "data": [1, 2, 3, 4] }, { "name": "B", "data": [0, 0.25, 0.5, 0.75] }], "expression": "QUANTILE(A, B)", "expect": [1, 1.75, 2.5, 3.25], "tol": 0 },
    { "name": "quantile-single-value", "columns": [{ "name": "A", "data": [5] }], "expression": "QUANTILE(A, 0.5)", "expect": [5], "tol": 0 },
    { "name": "quantile-all-nan", "columns": [{ "name": "A", "data": ["NaN", "NaN"] }], "expression": "QUANTILE(A, 0.5)", "expect": ["NaN", "NaN"], "tol": 0 },
    { "name": "quantile-skips-nonfinite", "columns": [{ "name": "A", "data": [1, "NaN", 3, "Infinity", 4] }], "expression": "QUANTILE(A, 0.5)", "expect": [3, 3, 3, 3, 3], "tol": 0 },
    { "name": "quantile-nan-q-is-nan", "columns": [{ "name": "A", "data": [1, 2, 3] }, { "name": "B", "data": ["NaN", "NaN", "NaN"] }], "expression": "QUANTILE(A, B)", "expect": ["NaN", "NaN", "NaN"], "tol": 0 },
