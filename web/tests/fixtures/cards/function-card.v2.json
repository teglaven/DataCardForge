    {
      "name": "summary-catalog-table",
      "comment": "builtin:summary is the first LAZY signature: creating the card must leave it dirty/notRequested with an EMPTY result (asserted by afterCreate), and only the explicit trigger computes. Shape is fixed by the signature + the statistic catalog in backend/src/signature.cpp, never by the data: 12 rows (catalog order), one column per input variable. Columns inherit the source column's annotation verbatim.",
      "matrices": [
        {
          "id": 30,
          "columns": [
            {
              "posName": "Pos.1",
              "annotation": "A",
              "data": [
                1,
                2,
                3,
                4
              ]
            },
            {
              "posName": "Pos.2",
              "annotation": "B",
              "data": [
                10,
                20,
                30,
                40
              ]
            }
          ]
        }
      ],
      "card": {
        "kind": "formula",
        "inputs": [
          {
            "portId": "src",
            "target": {
              "type": "matrix",
              "cardId": 15,
              "matrixId": 30
            }
          }
        ],
        "signatureId": "builtin:summary",
        "params": {}
      },
      "afterCreate": {
        "state": "dirty",
        "reason": "notRequested",
        "empty": true
      },
      "trigger": "compute",
      "expect": {
        "outputs": [
          {
            "outputId": "result",
            "columns": [
              {
                "name": "A",
                "data": [
                  4,
                  0,
                  2.5,
                  1.2909944487358056,
                  1.6666666666666667,
                  1,
                  1.75,
                  2.5,
                  3.25,
                  4,
                  1.5,
                  0.6454972243679028
                ]
              },
              {
                "name": "B",
